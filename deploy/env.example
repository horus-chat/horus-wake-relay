HORUS_WAKE_ADDR=127.0.0.1:8789
HORUS_WAKE_DB=/var/lib/horus/wake_tokens.sqlite

# APNs JWT auth (.p8 key — covers both regular and VoIP pushes)
APNS_KEY_PATH=/etc/horus/AuthKey.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_TOPIC=com.julienlhk.horus
# VoIP topic for PushKit (auto-derived as {APNS_TOPIC}.voip if unset)
# APNS_VOIP_TOPIC=com.julienlhk.horus.voip
# true for Xcode debug tokens; false for TestFlight / App Store
APNS_SANDBOX=true

# Optional until Firebase exists. Leave unset to 501 Android wakes.
# FCM_SERVICE_ACCOUNT_JSON=/etc/horus/fcm.json
# FCM_PROJECT_ID=
